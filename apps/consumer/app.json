{
  "expo": {
    "name": "CampusCart",
    "slug": "campuscart",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuscart",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.campuscart.student",
      "versionCode": 7,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#FFD23F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-upload-signing",
      "./plugins/with-order-ringer",
      "./plugins/with-optional-portrait",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CampusCart uses the camera so shops can take photos of their menu items.",
          "photosPermission": "CampusCart opens your photos so shops can pick pictures of their menu items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1A9E4B",
          "defaultChannel": "orders",
          "sounds": ["./assets/sounds/new_order.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD23F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusCart shows the student where you are while you deliver their order.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CampusCart uses the camera so shops can take photos of menu items and read barcodes when they restock.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "45967a13-6cd2-4594-a554-968f07e24fde"
      }
    },
    "owner": "ankit979915"
  }
}
