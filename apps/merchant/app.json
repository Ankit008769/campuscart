{
  "expo": {
    "name": "CampusCart Partner",
    "slug": "campuscart-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuscart-partner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.campuscart.merchant",
      "adaptiveIcon": {
        "backgroundColor": "#1A9E4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CampusCart Partner uses the camera to take photos of your menu items.",
          "photosPermission": "CampusCart Partner opens your photos so you can pick pictures of your menu items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1A9E4B",
          "defaultChannel": "orders",
          "sounds": ["./assets/sounds/new_order.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A9E4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CampusCart Partner uses the camera to take photos of your menu items and read barcodes when you restock.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97a280fe-7f86-4f90-aeb9-9c7532cf1d23"
      }
    },
    "owner": "ankit979915"
  }
}
